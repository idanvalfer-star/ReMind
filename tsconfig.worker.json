{
  // The Worker, the wire protocol it shares with the app, and their tests.
  //
  // Note the absence of `"types": ["@cloudflare/workers-types"]`. Installing those globally
  // *replaces* the DOM lib's WebCrypto declarations with workerd-specific ones that are
  // shaped differently — `generateKey` returns `CryptoKey | CryptoKeyPair`, `exportKey`
  // returns `JsonWebKey | ArrayBuffer`, and ECDH's `public` parameter is spelled `$public`.
  // Code written against them would then fail to typecheck in the node-based tests, and the
  // whole point of writing the push crypto against plain WebCrypto is that it runs in both
  // places unchanged.
  //
  // So: standard DOM types here, and the genuinely Cloudflare-specific types (D1Database,
  // ScheduledController) are imported by name where they are used.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    // node types are for the tests, which use node:crypto to drive the reference
    // implementation they diff against.
    "types": ["node"],
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  },
  "include": ["worker", "types", "src/shared"]
}
